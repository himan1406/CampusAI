NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://campusos:campusos_dev_password@localhost:5433/campusos
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
WEB_ORIGIN=http://localhost:5173

# Generate a different random value for each secret. Never commit server/.env.
# node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_BYTES
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIAL_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY

# Optional: restrict CampusOS signups to your college email domain.
# ALLOWED_EMAIL_DOMAIN=bennett.edu.in
ALLOWED_EMAIL_DOMAIN=

# Temporary compatibility only. Sprint 3 email connections require real CampusOS login.
DEV_AUTH_BYPASS=false
DEV_USER_ID=demo-student

# Google Cloud OAuth Web client. Add the exact redirect URI in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/email/oauth/gmail/callback
# For a phone on your Wi-Fi, use a publicly reachable HTTPS tunnel/domain callback.
GOOGLE_REDIRECT_URI_MOBILE=

# Microsoft Entra app registration. Add the exact redirect URI in Entra.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:4000/api/v1/email/oauth/outlook/callback
MICROSOFT_REDIRECT_URI_MOBILE=

# BennettTech / iLearn Moodle REST API integration.
LMS_BASE_URL=https://lms.bennett.edu.in
LMS_TOKEN_SERVICE=moodle_mobile_app

# Campus AI — local tool calling and Agentic RAG
OLLAMA_EMBED_MODEL=nomic-embed-text
APP_TIMEZONE=Asia/Kolkata
AI_MAX_TOOL_ROUNDS=6
AI_MAX_TOOL_CALLS=8
RAG_CHUNK_SIZE=1600
RAG_CHUNK_OVERLAP=250

# iLearn course-content indexing limits
LMS_CONTENT_SYNC=true
LMS_MAX_COURSES_FOR_CONTENTS=30
LMS_MAX_FILES_PER_SYNC=40
LMS_MAX_FILE_MB=12

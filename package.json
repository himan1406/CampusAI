{
  "name": "campusos",
  "version": "0.6.0",
  "private": true,
  "description": "CampusOS monorepo convenience scripts (no workspaces).",
  "scripts": {
    "install:all": "npm --prefix server install && npm --prefix web install",
    "dev:server": "npm --prefix server run dev",
    "dev:web": "npm --prefix web run dev",
    "check:server": "npm --prefix server run check",
    "build:web": "npm --prefix web run build",
    "check:web": "node web/scripts/check-classes.mjs"
  }
}
